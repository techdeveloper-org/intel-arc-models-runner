  "state": {
    "title": "Ring slot lifecycle (docs/formal/RingSlots.tla)",
    "nodes": [
      {"id": "EMPTY", "label": "EMPTY"},
      {"id": "PENDING", "label": "PENDING"},
      {"id": "READY", "label": "READY"}
    ],
    "edges": [
      {"from": "[*]", "to": "EMPTY", "label": "manager created"},
      {"from": "EMPTY", "to": "PENDING", "label": "reserve: caller becomes the single loader"},
      {"from": "PENDING", "to": "READY", "label": "publish: load finished, waiters woken"},
      {"from": "PENDING", "to": "EMPTY", "label": "load failed, slot reset"},
      {"from": "READY", "to": "PENDING", "label": "another layer maps to this slot"},
      {"from": "READY", "to": "EMPTY", "label": "release_layer_slot"},
      {"from": "READY", "to": "[*]", "label": "close"},
      {"from": "EMPTY", "to": "[*]", "label": "close"}
    ]
  },
  "sequence": {
    "title": "acquire_layer_weights",
    "participants": ["Consumer", "FlashStreamWeightManager", "NativeMemoryEngine", "libarc_native_sys"],
    "messages": [
      {"from": "Consumer", "to": "FlashStreamWeightManager", "text": "acquire_layer_weights(L)"},
      {"from": "FlashStreamWeightManager", "to": "FlashStreamWeightManager", "text": "_reserve_slot(L): hit, wait, or become loader"},
      {"from": "FlashStreamWeightManager", "to": "NativeMemoryEngine", "text": "get_tensor_buffer(L, name, dims, dtype)"},
      {"from": "NativeMemoryEngine", "to": "libarc_native_sys", "text": "arc_mmap_get_tensor_ptr (range checked, sealed)"},
      {"from": "libarc_native_sys", "to": "NativeMemoryEngine", "text": "pointer + size"},
      {"from": "NativeMemoryEngine", "to": "FlashStreamWeightManager", "text": "read-only view kept alive by _MappingGuard"},
      {"from": "FlashStreamWeightManager", "to": "FlashStreamWeightManager", "text": "_publish_load: slot READY, event set"},
      {"from": "FlashStreamWeightManager", "to": "Consumer", "text": "arrays"}
    ]
  },
  "activity": {
    "title": "Registering a layer with the native mapping",
    "nodes": [
